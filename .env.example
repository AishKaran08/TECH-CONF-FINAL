# Runway server configuration. Copy to .env and fill in what you need.
# Everything is optional: the app runs fully without any of these.

# AI (optional). Without a key, every AI feature falls back to local heuristics.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Server
PORT=8787
HOST=127.0.0.1

# Background refresh of GitHub + Codeforces, in minutes (can also be changed in Settings)
SYNC_INTERVAL_MINUTES=15

# Optional: where the local database lives (default: server/data)
# RUNWAY_DATA_DIR=
